# LevelUp Environment Variables
# Copy this to .env.local and fill in your values

# Neon PostgreSQL Database
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx.us-east-1.aws.neon.tech/levelup_db?sslmode=require
PGHOST=ep-xxxxx.us-east-1.aws.neon.tech
PGDATABASE=levelup_db
PGUSER=neondb_owner
PGPASSWORD=YOUR_NEON_PASSWORD
PGPORT=5432
PGSSLMODE=require

# Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Figma Integration
FIGMA_ACCESS_TOKEN=your-figma-token-here

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: File Storage
CLOUDINARY_URL=cloudinary://...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=levelup-evidence
